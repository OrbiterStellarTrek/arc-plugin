{
  "name": "arc-plugin",
  "version": "0.3.0",
  "description": "Arcaea 查分插件（绑定 / B50 / 单曲，对接 invtwd-server 国服/国际服双后端 + Shotium / Puppeteer 双渲染器）",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "render:demo": "node tools/render-preview.js",
    "render:shotium": "node tools/render-preview.js --renderer=shotium",
    "render:puppeteer": "node tools/render-preview.js --renderer=puppeteer",
    "assets:copy": "node tools/copy-assets.js"
  },
  "peerDependencies": {
    "@pixel.js/shotium": "^0.12.2",
    "puppeteer": "^24.16.2"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    },
    "@pixel.js/shotium": {
      "optional": true
    }
  },
  "keywords": [
    "Yunzai-Bot",
    "Arcaea"
  ],
  "license": "GPL-3.0-only",
  "dependencies": {
    "@qentimart/sdk": "^0.1.3"
  }
}
